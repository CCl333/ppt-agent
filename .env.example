APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 本地默认 SQLite。PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ppt
DATABASE_URL=sqlite:///./backend/data/ppt_agent.db
# production 启动只检查 schema 版本，不隐式 ALTER。升级：
# PYTHONPATH=backend python -m app.core.migrations
# SCHEMA_AUTO_MIGRATE=false

FILE_STORAGE_ROOT=./backend/data
UPLOAD_DIR=uploads
BACKGROUND_DIR=backgrounds
EXPORT_DIR=exports

# .env 只用于首次启动灌入模型库；运行时以设置页绑定为准。
CONTEXT_LLM_BASE_URL=https://api.openai.com/v1
CONTEXT_LLM_API_KEY=
CONTEXT_LLM_MODEL=gpt-4o-mini
CONTEXT_LLM_PATH=/chat/completions
CONTEXT_LLM_TIMEOUT_SECONDS=120

SVG_LLM_BASE_URL=https://api.openai.com/v1
SVG_LLM_API_KEY=
SVG_LLM_MODEL=gpt-4o-mini
SVG_LLM_PATH=/chat/completions
SVG_LLM_TIMEOUT_SECONDS=180

# 搜索：运行时以设置页「搜索配置」为准（博查 / Tavily / 大模型）。.env 仅作首次种子 / 回退。
MCP_BOCHA_URL=https://mcp.bochaai.com/sse
MCP_BOCHA_AUTH_HEADER=Bearer sk-xxxx
MCP_FETCH_URL=
MCP_FIRECRAWL_URL=
MCP_MARKITDOWN_URL=

# 网页全文解析：运行时以设置页「解析配置」为准。.env 仅作首次种子 / 回退。
# Tavily / Firecrawl 单独模式，或 grok-search web_fetch（Tavily 优先，失败降级 Firecrawl）。
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2

MAX_RESEARCH_CONCURRENCY=4
EVENT_STREAM_REPLAY_LIMIT=200
TASK_WORKER_ENABLED=true
TASK_WORKER_COUNT=2
TASK_LEASE_SECONDS=180
TASK_POLL_INTERVAL_MS=400
